import pandas as pd
import numpy as np

def enu_to_latlon(x, y, ref_lat, ref_lon):
    """ENU koordinatlarından lat/lon'a dönüş"""
    R = 6371000.0
    lat = ref_lat + (y / R) * 180.0 / np.pi
    lon = ref_lon + (x / (R * np.cos(ref_lat * np.pi / 180.0))) * 180.0 / np.pi
    return lat, lon

# 1. Mevcut tek uçaklı veriyi oku
KEEP_COLS = ["time", "x", "y", "z", "vx", "vy", "vz", "callsign", "lat", "lon", "alt_m", "time_unix"]

df1 = pd.read_csv("ground_truth_adsb.csv")[KEEP_COLS].copy()
df1["callsign"] = "HEDEF_1"

# Referans noktalarını al
ref_lat = df1["lat"].median()
ref_lon = df1["lon"].median()

# 2. İkinci uçak için verinin kopyasını oluştur (Aynalanmış Rota)
df2 = df1.copy()
df2["callsign"] = "HEDEF_2" 

# X konumunu merkeze göre ayna görüntüsü al
merkez_x = df1["x"].mean()
df2["x"] = merkez_x - (df1["x"] - merkez_x)
df2["vx"] = -df1["vx"]

# Lat/lon'u güncelleştirilmiş x,y'den hesapla
df2[["lat", "lon"]] = df2.apply(lambda row: pd.Series(enu_to_latlon(row["x"], row["y"], ref_lat, ref_lon)), axis=1)

# 3. Üçüncü uçak için verinin kopyasını oluştur (Non-lineer / Sinüzoidal Rota)
df3 = df1.copy()
df3["callsign"] = "HEDEF_3"

# Dalga frekansını belirlemek için zamanı sıfırdan başlatalım
t_norm = df3["time"] - df3["time"].min()

# Y ekseninde mevcut rotanın tersine uçsun
merkez_y = df1["y"].mean()
df3["y"] = merkez_y - (df1["y"] - merkez_y)
df3["vy"] = -df1["vy"]

# X ekseninde orijinal rotaya 15 km genliğinde bir sinüs dalgası ekleyerek non-lineer yapalım
df3["x"] = df1["x"] + np.sin(t_norm / 100.0) * 3000

# Hız (vx) değerini de x'in zamana göre türevini (kosinüs) alarak fiziksel kurallara uygun güncelleyelim
df3["vx"] = df1["vx"] + np.cos(t_norm / 100.0) * (3000 / 100.0)

# Lat/lon'u güncelleştirilmiş x,y'den hesapla
df3[["lat", "lon"]] = df3.apply(lambda row: pd.Series(enu_to_latlon(row["x"], row["y"], ref_lat, ref_lon)), axis=1)

# 4. Üç uçağın verilerini birleştir ve zamana göre sırala
df_multi = pd.concat([df1, df2, df3]).sort_values("time").reset_index(drop=True)

# 5. Yeni zorlu verisetini kaydet
df_multi.to_csv("ground_truth_adsb_multi.csv", index=False)
print("Çoklu hedef verisi başarıyla oluşturuldu: ground_truth_adsb_multi.csv (3 Hedef)")